# Application
NODE_ENV=development
PORT=3000
APP_NAME=Cinema Booking System

# Database
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=cinema_user
DATABASE_PASSWORD=cinema_password
DATABASE_NAME=cinema_db
DATABASE_SYNC=true
DATABASE_LOGGING=true

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_TTL=1800

# Kafka
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=cinema-booking-system
KAFKA_GROUP_ID=cinema-booking-group

# Reservation
RESERVATION_EXPIRATION_TIME=30000

# Rate Limiting
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# Logging
LOG_LEVEL=debug